# Environment Configuration for PoliceGPT RAG

# Qdrant Vector DB
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=policegpt_legal_corpus

# Embedding & Reranker Models
EMBEDDING_MODEL_NAME=BAAI/bge-m3
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
DEVICE=cuda # or cpu / mps

# LLM Backend (vLLM / Ollama / OpenAI / Groq / HuggingFace)
LLM_PROVIDER=ollama # or openai, vllm, huggingface
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:7b
LLM_API_KEY=your_api_key_here
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Application & Logging
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
